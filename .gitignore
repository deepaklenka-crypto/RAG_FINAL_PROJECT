# ==========================================
# OmniRAG Git Ignore Configuration
# ==========================================

# 1. Environment variables & API keys (NEVER commit secrets!)
.env
*.env
!.env.example

# 2. Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Local Database & Vector Storage files
data/rag_app.db
data/rag_app.db*
data/qdrant_storage/*
!data/qdrant_storage/.gitkeep

# 5. Dynamic / Runtime uploads
data/uploads/*
!data/uploads/.gitkeep

# 6. IDE / Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# 7. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# 8. Logs
*.log
