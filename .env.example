# ==============================================================================
# OmniRAG: Comprehensive Production Configuration (.env.example)
# Multi-Format 3-Type RAG (Simple, Hybrid, Graph)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & API Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Get your Gemini API key free at: https://aistudio.google.com/
# Leave blank to use the built-in intelligent local offline simulator
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Active LLM backend: 'gemini', 'vllm', or 'sglang'
LLM_BACKEND=gemini

# ------------------------------------------------------------------------------
# 2. Local On-Device Engines (Ollama - 100% Offline on Laptop CPU/GPU)
# ------------------------------------------------------------------------------
# Download Ollama from: https://ollama.com
# Recommended models:
#   ollama pull qwen2.5:3b     (Fast, default, excellent multilingual English & Hindi)
#   ollama pull qwen2.5vl:7b   (High-capacity deep reasoning)
#   ollama pull gemma2:2b      (Ultra-lightweight 2B model by Google)
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------------------
# 3. High-Throughput Self-Hosted Engines (vLLM & SGLang)
# ------------------------------------------------------------------------------
# vLLM Server (PagedAttention high-throughput continuous batching)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=empty

# SGLang Server (RadixAttention KV-cache reuse for multi-turn RAG)
SGLANG_API_BASE=http://localhost:30000/v1
SGLANG_MODEL=meta-llama/Llama-3.1-8B-Instruct
SGLANG_API_KEY=empty

# ------------------------------------------------------------------------------
# 3. Database Layer (PostgreSQL & SQLite Dual-Support)
# ------------------------------------------------------------------------------
# Set individual PostgreSQL parameters or full DATABASE_URL.
# If PostgreSQL is offline or credentials fail, it gracefully falls back to SQLite!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_project
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_project
# SQLite local fallback path:
# DATABASE_URL=sqlite:///./data/rag_app.db

# ------------------------------------------------------------------------------
# 4. Qdrant Vector Database
# ------------------------------------------------------------------------------
# If QDRANT_URL is empty, Qdrant runs embedded on local disk at QDRANT_PATH
QDRANT_PATH=./data/qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_multi_collection
QDRANT_DIMENSION=768

# ------------------------------------------------------------------------------
# 5. Chunking & Ingestion Strategies
# ------------------------------------------------------------------------------
# Strategy options: 'recursive', 'semantic', 'structured'
DEFAULT_CHUNKING_STRATEGY=recursive
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100

# Embedding options: 'gemini' (text-embedding-004) or 'local' (deterministic 768-dim hash)
DEFAULT_EMBEDDING_STRATEGY=gemini

# ------------------------------------------------------------------------------
# 6. RAG Paradigms & Scoring Techniques
# ------------------------------------------------------------------------------
# Active RAG type: 'simple', 'hybrid', or 'graph'
DEFAULT_RAG_TYPE=hybrid
DEFAULT_TOP_K=4
GRAPH_HOP_DEPTH=2

# Scoring parameters
# Reciprocal Rank Fusion constant k (default: 60)
RRF_K=60
# Linear score combination weight (alpha for dense, 1-alpha for sparse)
HYBRID_ALPHA=0.7
RERANKER_ENABLED=true
RERANKER_TOP_K=4

# ------------------------------------------------------------------------------
# 7. Optimization Tools & Acceleration
# ------------------------------------------------------------------------------
# Semantic Vector Response Cache (<10ms for identical or similar questions)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=1000

# Context Compression / Sentence Pruning (removes distractor/low-relevance sentences)
CONTEXT_COMPRESSION_ENABLED=false
COMPRESSION_THRESHOLD=0.15

# HyDE (Hypothetical Document Embeddings for zero-shot domain adaptation)
HYDE_ENABLED=false

# Query Expansion & Decomposition
QUERY_EXPANSION_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Multi-Level Evaluation & Corruption Analysis
# ------------------------------------------------------------------------------
PROMPT_EVAL_ENABLED=true
PROMPT_INJECTION_THRESHOLD=0.5
RESPONSE_EVAL_ENABLED=true
CORRUPTION_TEST_ENABLED=true
CORRUPTION_NOISE_LEVELS=0.0,0.25,0.50,0.75
LOG_LATENCY_TELEMETRY=true

# ------------------------------------------------------------------------------
# 9. Language & Response Modes
# ------------------------------------------------------------------------------
# Languages: 'en' (English), 'hi' (हिन्दी Hindi)
DEFAULT_LANGUAGE=en
# Modes: 'general' (Analytical Q&A), 'code' (Production Python PEP 8)
DEFAULT_MODE=general

# ------------------------------------------------------------------------------
# 10. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
